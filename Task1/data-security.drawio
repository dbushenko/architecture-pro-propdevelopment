        <mxCell id="0HkrXsL3Zcu7Pn4IBlt7-21" value="&lt;div&gt;- Персональные данные клиентов&lt;/div&gt;&lt;div&gt;- Персональные данные сотрудников&lt;/div&gt;&lt;div&gt;- Данные о бронированиях объектов&lt;/div&gt;&lt;div&gt;- История взаимодействий с клиентами&lt;/div&gt;&lt;div&gt;- Данные о текущих сделках&lt;/div&gt;&lt;div&gt;- Информация о ремонтных работах&lt;/div&gt;&lt;div&gt;- Информация для оплаты услуг ЖКХ&lt;/div&gt;" style="whiteSpace=wrap;html=1;shape=partialRectangle;top=0;left=0;bottom=1;right=0;points=[[0,1],[1,1]];fillColor=none;align=left;verticalAlign=bottom;routingCenterY=0.5;snapToPoint=1;recursiveResize=0;autosize=1;treeFolding=1;treeMoving=1;newEdgeStyle={&quot;edgeStyle&quot;:&quot;entityRelationEdgeStyle&quot;,&quot;startArrow&quot;:&quot;none&quot;,&quot;endArrow&quot;:&quot;none&quot;,&quot;segment&quot;:10,&quot;curved&quot;:1,&quot;sourcePerimeterSpacing&quot;:0,&quot;targetPerimeterSpacing&quot;:0};" vertex="1" parent="1">
